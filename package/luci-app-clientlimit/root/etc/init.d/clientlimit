#!/bin/sh /etc/rc.common

START=80
STOP=20

USE_PROCD=1

apply_rules() {
	local enabled ip download upload
	local _settings_enabled

	config_load clientlimit

	config_foreach _check_settings settings
	enabled=$_settings_enabled
	[ "$enabled" != "1" ] && return 1

	nft add table inet clientlimit 2>/dev/null

	nft flush chain inet clientlimit download 2>/dev/null
	nft flush chain inet clientlimit upload 2>/dev/null

	nft delete chain inet clientlimit download 2>/dev/null
	nft delete chain inet clientlimit upload 2>/dev/null

	nft add chain inet clientlimit download { type filter hook forward priority 1\; policy accept\; } 2>/dev/null
	nft add chain inet clientlimit upload { type filter hook forward priority 1\; policy accept\; } 2>/dev/null

	config_foreach _apply_client client
}

_check_settings() {
	config_get_bool _settings_enabled "$1" enabled 0
}

_apply_client() {
	local enabled ip download upload
	config_get_bool enabled "$1" enabled 0
	[ "$enabled" != "1" ] && return

	config_get ip "$1" ip
	[ -z "$ip" ] && return

	config_get download "$1" download "0"
	config_get upload "$1" upload "0"

	if [ "$download" != "0" ] && [ -n "$download" ]; then
		nft add rule inet clientlimit download ip daddr "$ip" limit rate over "$download" kbytes/second counter drop
	fi

	if [ "$upload" != "0" ] && [ -n "$upload" ]; then
		nft add rule inet clientlimit upload ip saddr "$ip" limit rate over "$upload" kbytes/second counter drop
	fi
}

cleanup() {
	nft delete table inet clientlimit 2>/dev/null
}

start_service() {
	apply_rules && {
		procd_open_instance
		procd_set_param command /bin/busybox sleep 365d
		procd_set_param respawn
		procd_close_instance
	}
}

stop_service() {
	cleanup
}

reload_service() {
	cleanup
	apply_rules && {
		procd_open_instance
		procd_set_param command /bin/busybox sleep 365d
		procd_set_param respawn
		procd_close_instance
	}
}

service_triggers() {
	procd_add_reload_trigger "clientlimit"
}
