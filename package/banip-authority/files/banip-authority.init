#!/bin/sh /etc/rc.common

USE_PROCD=1
START=94
STOP=13

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/banip-authority run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/sbin/banip-authority restore
}
