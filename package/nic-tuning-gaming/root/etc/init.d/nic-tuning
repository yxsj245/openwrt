#!/bin/sh /etc/rc.common

START=98

USE_PROCD=1

I226V_VENDOR="0x8086"
I226V_DEVICE="0x125c"

is_i226v() {
	local iface="$1"
	local dev_path="/sys/class/net/${iface}/device"
	local vendor device

	[ -d "$dev_path" ] || return 1
	vendor=$(cat "${dev_path}/vendor" 2>/dev/null)
	device=$(cat "${dev_path}/device" 2>/dev/null)
	[ "$vendor" = "$I226V_VENDOR" ] && [ "$device" = "$I226V_DEVICE" ]
}

scan_i226v_interfaces() {
	for d in /sys/class/net/eth*; do
		[ -d "$d" ] || continue
		local name=$(basename "$d")
		if is_i226v "$name"; then
			echo "$name"
		fi
	done
}

has_i226v() {
	scan_i226v_interfaces | grep -q .
}

apply_ethtool_tuning() {
	local iface="$1"
	logger -t nic-tuning "Applying i226-V gaming optimizations for ${iface}"

	ethtool -L "$iface" combined 4 2>/dev/null

	ethtool -C "$iface" adaptive-rx off adaptive-tx off 2>/dev/null
	ethtool -C "$iface" rx-usecs 8 tx-usecs 8 2>/dev/null

	ethtool -G "$iface" rx 256 tx 256 2>/dev/null

	ethtool -K "$iface" tso off gso off gro off 2>/dev/null
}

boot() {
	if ! has_i226v; then
		return 0
	fi

	for iface in $(scan_i226v_interfaces); do
		apply_ethtool_tuning "$iface"
	done

	logger -t nic-tuning "i226-V gaming NIC tuning completed"
}

start_service() {
	procd_open_instance
	procd_set_param command /bin/busybox sleep 365d
	procd_close_instance
}
