#!/bin/sh /etc/rc.common

START=99
STOP=10

EXTRA_COMMANDS="apply"
EXTRA_HELP="\tapply\t重新应用 i226-V 手工 IRQ 亲和性"

I226V_VENDOR="0x8086"
I226V_DEVICE="0x125c"

log_info() {
	logger -t irq-affinity "$*"
}

log_error() {
	logger -p daemon.err -t irq-affinity "$*"
}

is_i226v() {
	local iface="$1"
	local dev_path="/sys/class/net/${iface}/device"
	local vendor device

	[ -d "$dev_path" ] || return 1
	vendor=$(cat "${dev_path}/vendor" 2>/dev/null)
	device=$(cat "${dev_path}/device" 2>/dev/null)
	[ "$vendor" = "$I226V_VENDOR" ] && [ "$device" = "$I226V_DEVICE" ]
}

scan_i226v_interfaces() {
	local path iface

	for path in /sys/class/net/*; do
		[ -d "$path" ] || continue
		iface=${path##*/}
		is_i226v "$iface" && echo "$iface"
	done
}

get_irq_list() {
	local iface="$1"

	awk -v iface="$iface" '
		$0 ~ iface "-TxRx-" {
			irq = $1
			sub(/:$/, "", irq)
			print iface, irq
		}
	' /proc/interrupts
}

apply_manual_affinity() {
	local irq_mode total_cpus interfaces iface iface_count=0

	config_load nic-tuning
	config_get irq_mode settings irq_mode irqbalance
	[ "$irq_mode" = "manual" ] || return 0

	if pidof irqbalance >/dev/null 2>&1; then
		log_error "irqbalance 正在运行，已跳过手工 IRQ 绑定以避免策略冲突"
		return 1
	fi

	total_cpus=$(nproc 2>/dev/null || echo 1)
	[ "$total_cpus" -gt 1 ] || return 0

	interfaces=$(scan_i226v_interfaces)
	for iface in $interfaces; do
		iface_count=$((iface_count + 1))
	done

	for iface in $interfaces; do
		get_irq_list "$iface"
	done | awk -v total="$total_cpus" '
		BEGIN { cpu=1 }
		{
			print $1, $2, cpu
			cpu++
			if (cpu >= total) cpu=1
		}
	' | while read -r iface irq cpu; do
		[ -n "$irq" ] || continue
		if echo "$cpu" > "/proc/irq/${irq}/smp_affinity_list" 2>/dev/null; then
			log_info "${iface} IRQ ${irq} 已绑定到 CPU${cpu}"
		else
			log_error "${iface} IRQ ${irq} 绑定 CPU${cpu} 失败"
		fi
	done

	[ "$iface_count" -gt 0 ] && \
		log_info "i226-V 手工 IRQ 亲和性已应用，共检测到 ${iface_count} 个端口"
}

boot() {
	apply_manual_affinity
}

start() {
	apply_manual_affinity
}

reload() {
	apply_manual_affinity
}

apply() {
	apply_manual_affinity
}
