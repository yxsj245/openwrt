#!/bin/sh /etc/rc.common

START=99

USE_PROCD=1

I226V_VENDOR="0x8086"
I226V_DEVICE="0x125c"

TOTAL_CPUS=$(nproc 2>/dev/null || echo 4)

is_i226v() {
	local iface="$1"
	local dev_path="/sys/class/net/${iface}/device"
	local vendor device

	[ -d "$dev_path" ] || return 1
	vendor=$(cat "${dev_path}/vendor" 2>/dev/null)
	device=$(cat "${dev_path}/device" 2>/dev/null)
	[ "$vendor" = "$I226V_VENDOR" ] && [ "$device" = "$I226V_DEVICE" ]
}

scan_i226v_interfaces() {
	for d in /sys/class/net/eth*; do
		[ -d "$d" ] || continue
		local name=$(basename "$d")
		if is_i226v "$name"; then
			echo "$name"
		fi
	done
}

get_irq_list() {
	local iface="$1"
	awk -v iface="$iface" '
		$0 ~ iface"-TxRx-" {
			irq = $1
			sub(/:$/, "", irq)
			print irq
		}
	' /proc/interrupts
}

bind_irq_round_robin() {
	local iface="$1"
	local cpu_idx=1

	get_irq_list "$iface" | while read -r irq; do
		[ -z "$irq" ] && continue

		local mask
		mask=$(printf "%x" $((1 << (cpu_idx % TOTAL_CPUS))))
		echo "$mask" > "/proc/irq/${irq}/smp_affinity" 2>/dev/null && \
			logger -t irq-affinity "Bound ${iface} IRQ ${irq} -> CPU${cpu_idx}"

		cpu_idx=$((cpu_idx + 1))
	done
}

boot() {
	local iface_count=0
	for iface in $(scan_i226v_interfaces); do
		iface_count=$((iface_count + 1))
	done

	[ "$iface_count" -eq 0 ] && return 0

	[ "$TOTAL_CPUS" -lt 2 ] && return 0

	for iface in $(scan_i226v_interfaces); do
		bind_irq_round_robin "$iface"
	done

	logger -t irq-affinity "i226-V IRQ affinity configured (${iface_count} ports, ${TOTAL_CPUS} CPUs)"
}

start_service() {
	procd_open_instance
	procd_set_param command /bin/busybox sleep 365d
	procd_close_instance
}
